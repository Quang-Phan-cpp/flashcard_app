<div class="flashcard-header">
  <h1>Flashcards</h1>

  <%= link_to "New Flashcard", new_flashcard_path, class: "new-flashcard-btn" %>
</div>

<div class="cards">
  <% @flashcards.each do |card| %>

    <div class="flip-card">
      <div class="flip-card-inner">

        <div class="flip-card-front">
          <h3><%= card.word %></h3>
        </div>

        <div class="flip-card-back">
          <p><strong>Meaning:</strong> <%= card.meaning %></p>
          <p><strong>Example:</strong> <%= card.example %></p>
          <p><strong>Level:</strong> <%= card.level %></p>
        </div>

      </div>
      
    </div>

    <div class="card-actions">
      <%= link_to "Edit", edit_flashcard_path(card), class: "edit-btn" %>
    </div>

  <% end %>
</div>
